<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>the-monopoly-game-specs-core</artifactId>
    <version>0.8.0-SNAPSHOT</version>

    <dependencies>
        <dependency>
            <groupId>the.monopoly.game</groupId>
            <artifactId>the-monopoly-game-domain</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>the.monopoly.game</groupId>
            <artifactId>the-monopoly-game-cli</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Generated acceptance entry points are kept out of the hand written
             test sources, and out of the default build entirely.

             They live under target/, so compiling them by default made the
             result of `mvn test` depend on whether anyone had run
             acceptance/run-acceptance.sh since the last clean: 68 tests on a
             clean tree, 99 on a dirty one. Verification has to mean the same
             thing every time it is run, so the acceptance sources are compiled
             only when this profile asks for them. run-acceptance.sh does. -->
        <profile>
            <id>acceptance</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.build.directory}/generated-test-sources/acceptance</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <parent>
        <groupId>the.monopoly.game</groupId>
        <artifactId>the-monopoly-game-specs</artifactId>
        <version>0.8.0-SNAPSHOT</version>
    </parent>
</project>
